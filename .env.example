# 复制为 .env 后按需修改：cp .env.example .env
# docker compose、本机启动脚本、k8s-up.sh 都会读取这个文件；不创建 .env 时使用下面的开发默认值。
# 注意：MySQL / PostgreSQL 口令只在数据卷首次初始化时生效，已有数据卷修改口令需先 make docker-down-volumes

MYSQL_PASSWORD=root
PG_PASSWORD=postgres
# 生产环境务必修改：HS256 签名密钥，至少 32 字节
JWT_SECRET=dev-only-insecure-secret-0123456789abcdef0123
